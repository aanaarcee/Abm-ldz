<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Los scripts de la base van dentro del programa: con el argumento crear-base la aplicación crea la base, y al abrirse aplica las migraciones -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\sql\OficinaRegistros.sql" LogicalName="OficinaRegistros.sql" Link="sql\OficinaRegistros.sql" />
    <!-- Cambios de estructura: sql/Migraciones/NNN_nombre.sql.
         El prefijo "MigracionesPg." no se cambia: es el nombre con el que el servidor anota las migraciones aplicadas. -->
    <EmbeddedResource Include="..\..\sql\Migraciones\*.sql" LogicalName="MigracionesPg.%(Filename).sql" Link="sql\Migraciones\%(Filename).sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Oficina.Entidades\Oficina.Entidades.csproj" />
  </ItemGroup>

</Project>
